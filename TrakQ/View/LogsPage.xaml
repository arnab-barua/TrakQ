<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TrakQ.ViewModel"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             x:DataType="viewmodel:LogsPageViewModel"
             x:Class="TrakQ.View.LogsPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <Grid RowDefinitions="*, Auto" Padding="16">
        
        <!-- Log Terminal Viewer -->
        <Border Grid.Row="0" 
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#1E1E1E, Dark=#000000}"
                StrokeShape="RoundRectangle 12"
                Margin="0,0,0,16">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.1" />
            </Border.Shadow>
            
            <ScrollView Padding="16">
                <Label Text="{Binding LogText}"
                       FontSize="13"
                       FontFamily="Consolas"
                       TextColor="#A5D6A7"
                       LineBreakMode="CharacterWrap" />
            </ScrollView>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *" ColumnSpacing="8">
            <Button Grid.Column="0" 
                    Text="Refresh" 
                    Command="{Binding LoadLogsCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8">
                
            </Button>
            
            <Button Grid.Column="1" 
                    Text="Share" 
                    Command="{Binding ShareLogsCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    CornerRadius="8">
                
            </Button>
            
            <Button Grid.Column="2" 
                    Text="Clear" 
                    Command="{Binding ClearLogsCommand}"
                    BackgroundColor="#E53935"
                    TextColor="White"
                    CornerRadius="8"
                    IsEnabled="{Binding IsNotBusy}">
                
            </Button>
        </Grid>

        <ActivityIndicator Grid.RowSpan="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />
    </Grid>

</ContentPage>


