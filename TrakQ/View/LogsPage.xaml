<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TrakQ.ViewModel"
             x:DataType="viewmodel:LogsPageViewModel"
             x:Class="TrakQ.View.LogsPage"
             Title="{Binding Title}"
             Padding="20">

    <Grid RowDefinitions="*, Auto">
        <Border Grid.Row="0" Stroke="{StaticResource Primary}" StrokeThickness="1" Margin="0,0,0,10">
            <ScrollView>
                <Label Text="{Binding LogText}"
                       Padding="10"
                       FontSize="Caption"
                       FontFamily="Consolas"
                       LineBreakMode="CharacterWrap" />
            </ScrollView>
        </Border>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
            <Button Text="Refresh" 
                    Command="{Binding LoadLogsCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Share Logs" 
                    Command="{Binding ShareLogsCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Clear" 
                    Command="{Binding ClearLogsCommand}"
                    BackgroundColor="Red"
                    IsEnabled="{Binding IsNotBusy}" />
        </HorizontalStackLayout>

        <ActivityIndicator Grid.RowSpan="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />
    </Grid>

</ContentPage>

