<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    x:Class="TrakQ.View.MonthSummeryPage"
    xmlns:model="clr-namespace:TrakQ.Dto"
    xmlns:viewmodel="clr-namespace:TrakQ.ViewModel"
    x:DataType="viewmodel:MonthSummeryPageViewModel"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <Grid>
        <!-- Main Layout -->
        <Grid RowDefinitions="Auto, *" Padding="16">
            
            <!-- Header Selectors -->
            <Border Grid.Row="0"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="10"
                    Margin="0,0,0,16">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto, *, *, Auto" ColumnSpacing="12">
                    <!-- Prev Button -->
                    <Button Grid.Column="0"
                            Clicked="OnPreviousMonthMOveClicked"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="Transparent"
                            WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.ChevronLeft}" Color="{StaticResource Primary}" Size="18"/>
                        </Button.ImageSource>
                    </Button>

                    <material:PickerField Grid.Column="1"
                                          x:Name="MonthPicker"
                                          Title="Month"
                                          ItemsSource="{Binding Months}"
                                          SelectedItem="{Binding Month}" />
                                          
                    <material:PickerField Grid.Column="2"
                                          x:Name="YearPicker"
                                          Title="Year"
                                          ItemsSource="{Binding Years}"                        
                                          SelectedItem="{Binding Year}" />

                    <!-- Next Button -->
                    <Button Grid.Column="3"
                            Clicked="OnNextMonthMOveClicked"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="Transparent"
                            WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.ChevronRight}" Color="{StaticResource Primary}" Size="18"/>
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Summary Card -->
            <RefreshView Grid.Row="1"
                         Command="{Binding GetAllCommand}"
                         IsRefreshing="{Binding IsRefreshing}">
                
                <ScrollView>
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="24">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.08" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*, Auto" 
                              RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                              RowSpacing="16">
                            
                            <!-- Opening Balance -->
                            <Label Grid.Row="0" Grid.Column="0" FontSize="16" TextColor="{StaticResource Gray500}" Text="Opening balance" />
                            <Label Grid.Row="0" Grid.Column="1" HorizontalTextAlignment="End" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" Text="{Binding MonthSummery.TotalOpeningBalance, StringFormat='{0:N2}'}" />

                            <!-- Income -->
                            <Label Grid.Row="1" Grid.Column="0" FontSize="16" TextColor="{StaticResource Gray500}" Text="Income" />
                            <Label Grid.Row="1" Grid.Column="1" HorizontalTextAlignment="End" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" Text="{Binding MonthSummery.TotalIncome, StringFormat='{0:N2}'}" />

                            <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />

                            <!-- Total fund -->
                            <Label Grid.Row="3" Grid.Column="0" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" Text="Total fund" />
                            <Label Grid.Row="3" Grid.Column="1" HorizontalTextAlignment="End" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" Text="{Binding MonthSummery.TotalSourceOfFund, StringFormat='{0:N2}'}" />

                            <BoxView Grid.Row="4" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />

                            <!-- Total outflow -->
                            <Label Grid.Row="5" Grid.Column="0" FontSize="16" TextColor="{StaticResource Gray500}" Text="Total outflow" />
                            <Label Grid.Row="5" Grid.Column="1" HorizontalTextAlignment="End" FontSize="16" TextColor="#E53935" Text="{Binding MonthSummery.TotalExpense, StringFormat='{0:N2}'}" />

                            <!-- Remaining balance -->
                            <Label Grid.Row="6" Grid.Column="0" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" Text="Remaining balance" />
                            <Label Grid.Row="6" Grid.Column="1" HorizontalTextAlignment="End" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" Text="{Binding MonthSummery.RemainingBalance, StringFormat='{0:N2}'}" />

                            <BoxView Grid.Row="7" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />

                            <!-- Closing balance -->
                            <Label Grid.Row="8" Grid.Column="0" FontSize="16" TextColor="{StaticResource Gray500}" Text="Closing balance" />
                            <Label Grid.Row="8" Grid.Column="1" HorizontalTextAlignment="End" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" Text="{Binding MonthSummery.TotalClosingBalance, StringFormat='{0:N2}'}" />

                            <!-- Difference -->
                            <Label Grid.Row="9" Grid.Column="0" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Secondary}" Text="Difference" />
                            <Label Grid.Row="9" Grid.Column="1" HorizontalTextAlignment="End" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Secondary}" Text="{Binding MonthSummery.Difference, StringFormat='{0:N2}'}" />
                            
                        </Grid>
                    </Border>
                </ScrollView>
            </RefreshView>

        </Grid>

        <ActivityIndicator HorizontalOptions="Center"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>