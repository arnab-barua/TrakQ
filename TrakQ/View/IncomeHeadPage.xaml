<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TrakQ.View.IncomeHeadPage"
    xmlns:model="clr-namespace:TrakQ.Db.Data.Entities;assembly=TrakQ.Db"
    xmlns:viewmodel="clr-namespace:TrakQ.ViewModel"
    x:DataType="viewmodel:IncomeHeadViewModel"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <Grid>
        <!-- Main Layout -->
        <RefreshView Command="{Binding GetAllCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding IncomeHeads}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <ContentView HeightRequest="16" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <ContentView HeightRequest="80" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:IncomeHead">
                        <Grid Padding="16,0">
                            <Border StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                                    StrokeShape="RoundRectangle 12">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.08" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:IncomeHeadViewModel}}, x:DataType=viewmodel:IncomeHeadViewModel, Path=GoToDetailsCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Padding="16" VerticalOptions="Center">
                                    <Label FontSize="16" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                                           Text="{Binding IncomeHeadName}" />
                                    <Label FontSize="14" TextColor="{StaticResource Gray500}"
                                           Text="{Binding Note}" 
                                            />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Floating Action Button (FAB) -->
        <Button Text="+" 
                Command="{Binding CreateNewCommand}"
                IsEnabled="{Binding IsNotBusy}"
                WidthRequest="64" HeightRequest="64" CornerRadius="32"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="24"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontSize="32"
                Padding="0, -5, 0, 0">
            <Button.Shadow>
                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.4" />
            </Button.Shadow>
        </Button>


        <ActivityIndicator HorizontalOptions="Center"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center" />
    </Grid>

</ContentPage>

