<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    x:Class="TrakQ.View.IncomeHeadFormPage"
    xmlns:viewmodel="clr-namespace:TrakQ.ViewModel"
    x:DataType="viewmodel:IncomeHeadFormViewModel"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <ScrollView>
        <Grid Padding="16" RowSpacing="16">
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.08" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="20">
                    
                    <Label Text="Category Details" 
                           FontSize="20" 
                           FontFamily="OpenSansSemibold" 
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                           Margin="0,0,0,8" />

                    <material:TextField
                        Title="Name"
                        Text="{Binding IncomeHead.IncomeHeadName}" />

                    <material:EditorField
                        Title="Note"
                        HeightRequest="100"
                        Text="{Binding IncomeHead.Note}" />

                    <Button
                        Text="SAVE"
                        Command="{Binding SaveCommand}"
                        CornerRadius="24"
                        HeightRequest="48"
                        Margin="0, 16, 0, 0"
                        FontAttributes="Bold"
                        FontSize="16"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.3" />
                        </Button.Shadow>
                    </Button>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>