<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TrakQ.View.ExpenseHeadFormPage"
    xmlns:model="clr-namespace:TrakQ.Dto"
    xmlns:viewmodel="clr-namespace:TrakQ.ViewModel"
    x:DataType="viewmodel:ExpenseHeadFormViewModel"
    Title="{Binding Title}">

    <Grid
        ColumnDefinitions="*"
        RowDefinitions="Auto,*"
        RowSpacing="5"
        Padding="10">
        <VerticalStackLayout Padding="20" Spacing="15" Grid.Row="0">
            <Label Text="{Binding ExpenseHead.ParentName}" />

            <Entry
                Placeholder="Name"
                Text="{Binding ExpenseHead.Name}" />

            <Editor
                Placeholder="Note"
                HeightRequest="100"
                Text="{Binding ExpenseHead.Note}" />
            
            <Entry
                Placeholder="FixedAmount"
                Keyboard="Numeric"
                Text="{Binding ExpenseHead.FixedAmount}" />

            <Entry
                Placeholder="Budget"
                Keyboard="Numeric"
                Text="{Binding ExpenseHead.Budget}" />


        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="Save"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Command="{Binding SaveCommand}" />
    </Grid>
</ContentPage>