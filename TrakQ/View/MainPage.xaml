<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    x:Class="TrakQ.View.MainPage"
    xmlns:viewmodel="clr-namespace:TrakQ.ViewModel"
    x:DataType="viewmodel:MainPageViewModel"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">

            <!-- Welcome Card -->
            <Border StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 16"
                    Padding="24">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Welcome to TrakQ!"
                           FontSize="24"
                           FontFamily="OpenSansSemibold"
                           TextColor="White" />
                    <Label Text="Manage your personal finances efficiently."
                           FontSize="14"
                           TextColor="#E8F5E9" />
                </VerticalStackLayout>
            </Border>

            <!-- Data Management Card -->
            <Label Text="Data Management"
                   FontSize="18"
                   FontFamily="OpenSansSemibold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                   Margin="4, 0, 0, -12" />

            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.08" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="16">

                    <Label Text="Backup and restore your SQLite database."
                           FontSize="14"
                           TextColor="{StaticResource Gray500}"
                           Margin="0,0,0,8" />

                    <!-- Request Permission Button -->
                    <Button Text="1. Request Permissions" 
                            Command="{Binding RequestPermissionCommand}"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.Key}" Color="{StaticResource Primary}" Size="16"/>
                        </Button.ImageSource>
                    </Button>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                        <!-- Export Button -->
                        <Button Grid.Column="0"
                                Text="Export Data" 
                                Command="{Binding ExportDataCommand}"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="White">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.FileExport}" Color="White" Size="16"/>
                            </Button.ImageSource>
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Secondary}" Offset="0,2" Radius="6" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>

                        <!-- Import Button -->
                        <Button Grid.Column="1"
                                Text="Import Data"
                                Command="{Binding PickFileCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.FileImport}" Color="White" Size="16"/>
                            </Button.ImageSource>
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Activity Indicator -->
            <ActivityIndicator HorizontalOptions="Center"
                               Margin="0,20,0,0"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
