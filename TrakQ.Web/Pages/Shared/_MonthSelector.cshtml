@model MonthSelector
<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label fw-semibold mb-1">Month</label>
        <select name="month" class="form-select form-select-sm">
            @foreach (var m in MonthSelector.AvailableMonths)
            {
                <option value="@m.Value" selected="@(m.Value == Model.Month)">@m.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label fw-semibold mb-1">Year</label>
        <select name="year" class="form-select form-select-sm">
            @foreach (var y in MonthSelector.AvailableYears)
            {
                <option value="@y" selected="@(y == Model.Year)">@y</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Apply</button>
    </div>
</form>
