@page
@model TrakQ.Web.Pages.Reports.ExpenseByHeadModel
@{
    ViewData["Title"] = "Expense by Head";
}

@functions {
    void RenderNode(TrakQ.Web.Models.ExpenseHeadTotalNode node, int depth)
    {
        if (node.Total == 0 && !node.Children.Any()) return;
        var indent = depth * 20;
        <tr class="@(depth == 0 ? "fw-semibold" : "")">
            <td style="padding-left: @(indent + 12)px">@node.HeadName</td>
            @if (node.Budget.HasValue && node.Budget > 0)
            {
                var pct = node.Budget > 0 ? (int)(node.Total / node.Budget * 100) : 0;
                var barClass = pct > 100 ? "bg-danger" : pct > 80 ? "bg-warning" : "bg-success";
                <td class="text-end">@node.Budget.Value.ToString("N2")</td>
                <td>
                    <div class="progress" style="height:6px;min-width:80px">
                        <div class="progress-bar @barClass" style="width:@(Math.Min(pct,100))%"></div>
                    </div>
                    <small class="text-muted">@pct%</small>
                </td>
            }
            else
            {
                <td></td><td></td>
            }
            <td class="text-end @(depth == 0 && node.Total > 0 ? "text-danger" : "")">
                @(node.Total > 0 ? node.Total.ToString("N2") : "-")
            </td>
        </tr>
        foreach (var child in node.Children.OrderByDescending(c => c.Total))
        {
            RenderNode(child, depth + 1);
        }
    }
}

<h2 class="mb-1">Expense by Head</h2>
<p class="text-muted mb-3">@Model.Selector.MonthName @Model.Selector.Year</p>

<partial name="_MonthSelector" model="Model.Selector" />

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="text-muted small mb-1">Grand Total</div>
                <div class="fs-3 fw-bold text-danger">@Model.GrandTotal.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Roots.Any(r => r.Total > 0))
{
    <div class="row g-4 mb-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-semibold">Category Share</div>
                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:280px">
                    <canvas id="headShareChart" style="max-height:260px"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-semibold">Breakdown</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th class="text-end">Budget</th>
                                <th>Used</th>
                                <th class="text-end">Spent</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var root in Model.Roots.OrderByDescending(r => r.Total))
                            {
                                RenderNode(root, 0);
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="3" class="text-end">Total</td>
                                <td class="text-end">@Model.GrandTotal.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary">No expense records found for this period.</div>
}

@section Scripts {
    <script>
        window.__chartData = window.__chartData || {};
        window.__chartData.headShare = @Html.Raw(Model.HeadShareChartJson);
    </script>
}
