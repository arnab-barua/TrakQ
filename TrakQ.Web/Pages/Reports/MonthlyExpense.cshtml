@page
@model TrakQ.Web.Pages.Reports.MonthlyExpenseModel
@{
    ViewData["Title"] = "Monthly Expenses";
}

<h2 class="mb-1">Monthly Expenses</h2>
<p class="text-muted mb-3">@Model.Selector.MonthName @Model.Selector.Year</p>

<partial name="_MonthSelector" model="Model.Selector" />

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="text-muted small mb-1">Total Expenses</div>
                <div class="fs-3 fw-bold text-danger">@Model.Total.ToString("N2")</div>
                <div class="text-muted small">@Model.Expenses.Count transaction(s)</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Expenses.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent fw-semibold">Daily Expense Distribution</div>
        <div class="card-body">
            <canvas id="dailyChart" style="max-height:280px"></canvas>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent fw-semibold">Transactions</div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Remark</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Expenses)
                    {
                        <tr>
                            <td>@row.Date.ToString("dd MMM")</td>
                            <td>@row.HeadName</td>
                            <td class="text-muted small">@row.Remark</td>
                            <td class="text-end">@row.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="3" class="text-end">Total</td>
                        <td class="text-end">@Model.Total.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary">No expense records found for this period.</div>
}

@section Scripts {
    <script>
        window.__chartData = window.__chartData || {};
        window.__chartData.daily = @Html.Raw(Model.DailyChartJson);
    </script>
}
