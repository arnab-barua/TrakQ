@page
@model TrakQ.Web.Pages.Reports.SummaryModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-1">Dashboard</h2>
<p class="text-muted mb-3">@Model.Selector.MonthName @Model.Selector.Year</p>

<partial name="_MonthSelector" model="Model.Selector" />

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Total Income</div>
                <div class="fs-4 fw-bold text-success">@Model.Summary.TotalIncome.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Total Expense</div>
                <div class="fs-4 fw-bold text-danger">@Model.Summary.TotalExpense.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Net Savings</div>
                <div class="fs-4 fw-bold @(Model.Summary.NetSavings >= 0 ? "text-success" : "text-danger")">
                    @Model.Summary.NetSavings.ToString("N2")
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Closing Balance</div>
                <div class="fs-4 fw-bold text-primary">@Model.Summary.TotalClosingBalance.ToString("N2")</div>
                <div class="text-muted small">Opening: @Model.Summary.TotalOpeningBalance.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent fw-semibold">Income vs Expense</div>
            <div class="card-body d-flex align-items-center justify-content-center" style="min-height:260px">
                <canvas id="incomeExpenseChart" style="max-height:240px"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent fw-semibold">Top Expense Heads</div>
            <div class="card-body" style="min-height:260px">
                <canvas id="topHeadsChart" style="max-height:240px"></canvas>
            </div>
        </div>
    </div>
</div>

@if (Model.Summary.TopExpenseHeads.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent fw-semibold">Top 5 Expense Categories</div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Category</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">% of Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var head in Model.Summary.TopExpenseHeads)
                    {
                        var pct = Model.Summary.TotalExpense > 0
                            ? head.Amount / Model.Summary.TotalExpense * 100 : 0;
                        <tr>
                            <td>@head.HeadName</td>
                            <td class="text-end">@head.Amount.ToString("N2")</td>
                            <td class="text-end">@pct.ToString("F1")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        window.__chartData = window.__chartData || {};
        window.__chartData.incomeExpense = @Html.Raw(Model.IncomeExpenseChartJson);
        window.__chartData.topHeads = @Html.Raw(Model.TopHeadsChartJson);
    </script>
}
